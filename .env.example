# Copia a .env y coloca la clave localmente. No compartir ni registrar la clave.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
PORT=3000
APP_TIMEZONE=America/Bogota
MAX_TURN_ITERATIONS=8
MAX_SESSION_TOKENS=30000
MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_MS=30000
# Opcional: clave de acceso de al menos 12 caracteres para compartir la demo.
# DEMO_ACCESS_CODE=
